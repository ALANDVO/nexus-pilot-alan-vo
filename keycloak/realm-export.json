{
  "realm": "nexus-pilot",
  "enabled": true,
  "displayName": "Nexus Pilot",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "nexus-pilot-client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "change-me-in-production",
      "redirectUris": [
        "http://127.0.0.1:5173/callback",
        "http://127.0.0.1:5173/*"
      ],
      "webOrigins": [
        "http://127.0.0.1:5173"
      ],
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "900",
        "client.secret.creation.time": "0"
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "Read-only access to parts and unfold results",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "operator",
        "description": "Upload parts, run unfold jobs, manage own data",
        "composite": true,
        "composites": {
          "realm": ["viewer"]
        },
        "clientRole": false
      },
      {
        "name": "admin",
        "description": "Full access including user management",
        "composite": true,
        "composites": {
          "realm": ["operator"]
        },
        "clientRole": false
      }
    ]
  },
  "groups": [],
  "identityProviders": [],
  "clientScopes": [
    {
      "name": "roles",
      "description": "Realm roles mapped to token claims",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ]
}